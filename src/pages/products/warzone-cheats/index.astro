---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { cheatPages, productHub, productPages } from '../../../data/products';
import { resolvePageSeo } from '../../../config/seo';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCatalogSection from '../../../components/ProductCatalogSection.astro';
import { cheatPath } from '../../../utils/path';

const seo = resolvePageSeo('/products/warzone-cheats/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const utilitySlugs = ['hwid-spoofer', 'ugc', 'unlock-all'] as const;
const listedProducts = [
  cheatPages[0],
  ...productPages.filter((p) => utilitySlugs.includes(p.slug as (typeof utilitySlugs)[number])),
].filter(Boolean);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: productHub.title,
      description: productHub.description,
      url: productHub.path,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      listedProducts.map((product) => ({
        name: product.title,
        url: cheatPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="mt-6">
      <ProductCatalogSection variant="hub" titleId="products-page-title" />
    </div>
    <div class="mx-auto max-w-6xl px-5">
      <div class="mt-10 max-w-3xl space-y-6 text-sm leading-relaxed text-muted-foreground md:text-base">
        <section aria-labelledby="products-warzone-modules-heading">
          <h2 id="products-warzone-modules-heading" class="text-xl font-bold text-foreground md:text-2xl">
            Warzone cheats modules on one listing
          </h2>
          <p class="mt-3">
            This hub lists Warzone Cheats with aimbot (Humanizer), player ESP, bots ESP, items ESP, colors, key binds,
            and configs—plus HWID Spoofer, UGC, and Skin Changer on Windows PC.
          </p>
        </section>
        <section aria-labelledby="products-compare-heading">
          <h2 id="products-compare-heading" class="text-xl font-bold text-foreground md:text-2xl">
            Compare utilities before checkout
          </h2>
          <p class="mt-3">
            Open each card’s View details page for system requirements, module lists, and checkout.
          </p>
        </section>
        <section aria-labelledby="products-platform-heading">
          <h2 id="products-platform-heading" class="text-xl font-bold text-foreground md:text-2xl">
            Supported Call of Duty titles on PC
          </h2>
          <p class="mt-3">
            Supported titles include Warzone, MW2, MW3, BO6, and BO7 on Steam, Battle.net, and Microsoft Store. Cloud DMA is
            required for full functionality.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
