---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { resolvePageSeo } from '../config/seo';
import { reviews, reviewGroups } from '../data/reviews';
const seo = resolvePageSeo('/warzone-reviews/');
const average = (reviews.reduce((total, review) => total + review.rating, 0) / reviews.length).toFixed(2);
---
<BaseLayout title={seo.title} description={seo.description}>
  <section class="section-shell py-16 md:py-24">
    <Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/warzone-reviews/' }]} />
    <header class="section-header mt-8">
      <p class="section-header__eyebrow">Reviews</p>
      <h1 class="section-header__title">Reviews: knowing exactly where teams are pushing makes competitive play clearer</h1>
      <p class="section-header__subtitle"><strong class="text-primary">{average} / 5</strong> · {reviews.length} reviews about features, performance, setup, and support.</p>
    </header>
    <nav aria-label="Review ratings" class="my-8 flex flex-wrap justify-center gap-3">
      {reviewGroups.map(group => <a href={`#reviews-${group.rating}`} class="rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm text-primary hover:bg-primary/20">{group.rating}-star ({group.reviews.length})</a>)}
    </nav>
    {reviewGroups.map((group, index) => <section id={`reviews-${group.rating}`} aria-labelledby={`rating-${group.rating}`} class="mt-12 scroll-mt-24">
      <h2 id={`rating-${group.rating}`} class="mb-5 text-xl font-semibold">Part {index + 1}: {group.rating}-Star Reviews <span class="text-sm font-normal text-muted-foreground">({group.reviews.length} Total)</span></h2>
      <div class="grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {group.reviews.map(review => <article class="rounded-2xl border border-border bg-card p-5 shadow-sm">
          <h3 class="break-words text-sm font-semibold">{review.user}</h3>
          <p class="mt-2 tracking-wider text-primary" aria-label={`${review.rating} out of 5 stars`}>{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</p>
          <blockquote class="mt-3 text-sm leading-relaxed text-muted-foreground">“{review.text}”</blockquote>
        </article>)}
      </div>
    </section>)}
  </section>
</BaseLayout>
