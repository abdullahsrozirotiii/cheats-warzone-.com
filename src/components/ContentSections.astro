---
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations } from '../i18n';
import { getFeaturedBlogPosts } from '../data/blog';
import WorkflowSection from './WorkflowSection.astro';
import SectionHeader from './SectionHeader.astro';
import BlogCard from './BlogCard.astro';
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import SiteFaqSection from './SiteFaqSection.astro';
import { getLocalizedFaqs } from '../data/faq';
import { Button } from '@/components/starwind/button';

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const homeFaqs = getLocalizedFaqs(locale);
const featuredPosts = getFeaturedBlogPosts(3, locale);
---

<WorkflowSection />

<section id="blog" class="border-y border-border bg-muted/20 py-16 md:py-24" aria-labelledby="blog-title">
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader eyebrow={t.blog.eyebrow} title={t.blog.title} desc={t.blog.subtitle} titleId="blog-title" />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
      {featuredPosts.map((post, i) => (
        <BlogCard post={post} index={i} />
      ))}
    </div>

    <div class="mt-10 flex justify-center">
      <Button
        as="a"
        href={ROUTES.blog}
        variant="outline"
        size="lg"
        class="rounded-xl"
        aria-label={`${t.blog.seeMore} Warzone cheat guides and articles`}
      >
        {t.blog.seeMore}<span class="sr-only"> Warzone cheat guides and articles</span>
        <Icon name="arrowRight" size={18} />
      </Button>
    </div>
  </div>
</section>

<SiteFaqSection id="faq" titleId="faq-title" items={homeFaqs} />
