---
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations } from '../i18n';
import { Separator } from '@/components/starwind/separator';
import BrandMark from './BrandMark.astro';
const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const resourceLinks = [
  { href: '/warzone-blog/', label: 'Blog archive' },
  { href: '/warzone-blog/warzone-radar/', label: 'Radar hack guide', noLocalize: true },
  { href: '/warzone-forum/', label: 'Forum' },
  { href: '/warzone-forum/before-buying/', label: 'Before you buy', noLocalize: true },
  { href: '/warzone-forum/aim-recoil/', label: 'Aim & recoil forum', noLocalize: true },
  { href: '/warzone-forum/console-cheats/', label: 'Console cheats forum', noLocalize: true },
  { href: '/products/warzone-cheats/aimbot-esp/', label: 'Aimbot & ESP listing', noLocalize: true },
  { href: '/products/warzone-cheats/', label: 'Product catalog', noLocalize: true },
  { href: '/warzone-support/', label: t.footer.support },
];

const legalLinks = [
  { href: '/warzone-about/', label: t.footer.about },
  { href: '/warzone-privacy/', label: t.footer.privacy },
  { href: '/warzone-terms/', label: t.footer.terms },
];
---

<footer class="border-t border-neutral-200 bg-neutral-50 py-16 dark:border-border dark:bg-muted/30">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <BrandMark logoHeight={40} loading="lazy" style="--brand-mark-h: 2.5rem" />
        <p class="text-sm text-neutral-700 dark:text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground"
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
                {...(link.noLocalize ? { 'data-no-localize': 'true' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground"
                {...(link.noLocalize ? { 'data-no-localize': 'true' } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-600 dark:text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-neutral-700 transition-colors hover:text-primary dark:text-muted-foreground">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-left text-sm text-neutral-600 dark:text-muted-foreground">
      &copy; {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
