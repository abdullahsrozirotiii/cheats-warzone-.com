---
interface Props {
  class?: string;
  ariaLabel?: string;
  size?: 'default' | 'sm' | 'md';
}

const { class: className, ariaLabel = 'Toggle light and dark mode', size = 'default' } = Astro.props;
---

<label
  class:list={[
    'theme-mode-switch',
    size === 'sm' && 'theme-mode-switch--sm',
    size === 'md' && 'theme-mode-switch--md',
    className,
  ]}
>
  <input
    type="checkbox"
    aria-label={ariaLabel}
    data-sw-theme-control
    data-theme-on="dark"
    data-theme-off="light"
  />
  <span class="theme-mode-switch__slider" aria-hidden="true"></span>
</label>

<script>
  function setupThemeController() {
    const isDark = document.documentElement.classList.contains('dark');
    document.querySelectorAll<HTMLInputElement>('input[data-sw-theme-control]').forEach((input) => {
      input.checked = isDark;
      if (input.dataset.swBound === '1') return;
      input.dataset.swBound = '1';

      input.addEventListener('change', () => {
        const nextDark = input.checked;
        document.documentElement.classList.toggle('dark', nextDark);
        try {
          const val = nextDark ? 'dark' : 'light';
          localStorage.setItem('colorTheme', val);
          localStorage.setItem('starwind-theme', val);
          localStorage.setItem('theme', val);
        } catch (e) {}
        document.querySelectorAll<HTMLInputElement>('input[data-sw-theme-control]').forEach((other) => {
          other.checked = nextDark;
        });
      });
    });
  }

  setupThemeController();
  document.addEventListener('astro:after-swap', setupThemeController);
</script>
